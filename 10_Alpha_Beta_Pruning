
INF = float("inf")

# Leaf values encountered from right to left
leaf_values = [5, 3, 2, 4, 1, 3, 6, 2, 8, 7, 5, 1, 3, 4]

index = 0
evaluated_leaves = []
pruned_leaves = []


def get_leaf():
    global index

    if index >= len(leaf_values):
        raise ValueError("Not enough leaf values.")

    value = leaf_values[index]
    index += 1
    evaluated_leaves.append(value)

    return value


def alpha_beta(depth, alpha, beta, maximizing_player, node_name="Root"):
    global index

    # At cutoff depth, evaluate a leaf.
    if depth == 4:
        value = get_leaf()
        print(f"Evaluating {node_name}: {value}")
        return value

    if maximizing_player:
        value = -INF

        # Right child is generated first.
        value = max(
            value,
            alpha_beta(depth + 1, alpha, beta, False,
                        node_name + " -> R")
        )
        alpha = max(alpha, value)

        # Check whether left child can be pruned.
        if alpha >= beta:
            print(f"PRUNED at {node_name}: Left subtree")
            return value

        value = max(
            value,
            alpha_beta(depth + 1, alpha, beta, False,
                        node_name + " -> L")
        )
        alpha = max(alpha, value)

        return value

    else:
        value = INF

        # Right child is generated first.
        value = min(
            value,
            alpha_beta(depth + 1, alpha, beta, True,
                        node_name + " -> R")
        )
        beta = min(beta, value)

        # Check whether left child can be pruned.
        if alpha >= beta:
            print(f"PRUNED at {node_name}: Left subtree")
            return value

        value = min(
            value,
            alpha_beta(depth + 1, alpha, beta, True,
                        node_name + " -> L")
        )
        beta = min(beta, value)

        return value


# ---------------------------------------------------------
# Main Program
# ---------------------------------------------------------

print("Alpha-Beta Pruning")
print("------------------")
print("MIN is the root node.")
print("Nodes are generated from RIGHT to LEFT.\n")

result = alpha_beta(
    depth=0,
    alpha=-INF,
    beta=INF,
    maximizing_player=False
)

print("\n--------------------------------")
print("Evaluated leaf values:", evaluated_leaves)
print("Number of evaluated leaves:", len(evaluated_leaves))
print("MINIMAX value at root:", result)
print("--------------------------------")


