print("Hello")

cities = ["A", "B", "C", "D"]

distance = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

tour = [0, 1, 2, 3]

def cost(tour):
    total = 0
    for i in range(4):
        total += distance[tour[i]][tour[(i + 1) % 4]]
    return total

print("Initial Tour:", tour)
print("Initial Distance:", cost(tour))

while True:
    old_cost = cost(tour)
    found = False

    for i in range(1, 4):
        for j in range(i + 1, 4):

            new_tour = tour.copy()
            new_tour[i], new_tour[j] = new_tour[j], new_tour[i]

            if cost(new_tour) < old_cost:
                tour = new_tour
                found = True
                break

        if found:
            break

    if not found:
        break

print("Final Tour:")

for i in tour:
    print(cities[i], end=" -> ")

print(cities[tour[0]])
print("Total Distance:", cost(tour))
